# Core runtime
ARB_CONFIG_PATH=./config.yaml
ARB_MODE=paper
ARB_LOG_LEVEL=info

# Storage and metrics
ARB_DB_PATH=./arb.sqlite
ARB_METRICS_PORT=9102

# Alerts (optional)
ARB_ALERT_WEBHOOK=

# EVM execution
ARB_EVM_PRIVATE_KEY=
ARB_EVM_CHAIN_ID=42161
ARB_EVM_RPC_URL=
ARB_EVM_TOKEN_MAP={"42161":{"ETH":{"address":"0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE","decimals":18},"USDC":{"address":"0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8","decimals":6}}}

# 0x + Uniswap quoting
ARB_0X_BASE_URL=https://api.0x.org
ARB_0X_PAIRS=[{"chainId":42161,"sellToken":"0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE","buyToken":"0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8","sellAmount":"10000000000000000","base":"ETH","quote":"USDC"}]
ARB_UNISWAP_PAIRS=[{"chainId":42161,"sellToken":"0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE","buyToken":"0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8","sellAmount":"10000000000000000","base":"ETH","quote":"USDC"}]

# Uniswap execution
ARB_UNISWAP_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
ARB_UNISWAP_POOL_FEE=3000

# Solana execution
ARB_SOLANA_PRIVATE_KEY=
ARB_SOLANA_TOKEN_MAP={"SOL":{"mint":"So11111111111111111111111111111111111111112","decimals":9},"USDC":{"mint":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","decimals":6}}

# Jupiter quoting
ARB_SOLANA_PAIRS=[{"inputMint":"So11111111111111111111111111111111111111112","outputMint":"EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v","amount":10000000,"base":"SOL","quote":"USDC"}]

# CEX quoting
ARB_CEX_SYMBOLS=["ETHUSDT"]

# Hyperliquid (perps)
ARB_HL_API_URL=https://api.hyperliquid.xyz
ARB_HL_COINS=["BTC","ETH"]
ARB_HL_PRIVATE_KEY=

# Slippage limits
ARB_MAX_SLIPPAGE_PCT=0.005
ARB_MAX_SLIPPAGE_BPS=50
